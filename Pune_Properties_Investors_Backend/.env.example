# ==============================================================================
# PUNE PROPERTY INVESTORS (PPI) - BACKEND SECURITY & DATABASE ENVIRONMENT CONFIG
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (Strict Security)
FRONTEND_URL=http://localhost:3000

# JWT Security Key (MUST be a long, cryptographically random secret string in production)
JWT_SECRET=ppi_super_secret_jwt_production_key_2026_change_in_prod

# ------------------------------------------------------------------------------
# MySQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (Common for PlanetScale, Aiven, AWS RDS, Railway)
# Example: mysql://username:password@host:3306/database_name?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# Option B: Discrete Parameters (Local MySQL / XAMPP / WAMP / VPS)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ppi_real_estate
MYSQL_SSL=false
